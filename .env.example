# Texas Hold'em Poker — 环境变量模板
# 使用方法: 复制为 .env 后填入真实密钥(`.env` 已被 gitignore,不会入库)
#   Windows:  copy .env.example .env
#   Linux/macOS: cp .env.example .env
#
# 服务器启动时自动加载(python-dotenv);优先级:
#   环境变量(含 .env) > config/llm_config.json > 代码默认值
# 核心游戏(规则 Bot)无需以下任何配置即可运行。

# ── LLM API Key(启用 LLM Bot 需填其一)─────────────────────────────────
# 通用项目 Key(设置面板保存的 Key 也写到这里)
THP_LLM_API_KEY=

# 或按 Provider 提供(THP_LLM_API_KEY 为空时按 provider 取对应变量)
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=          # 通义千问
# GLM_API_KEY=
# MOONSHOT_API_KEY=           # Kimi
# MINIMAX_API_KEY=
# ARK_API_KEY=                # 火山引擎
# LONGCAT_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Ollama 本地部署无需 Key(THP_LLM_PROVIDER=ollama, 端点默认 http://localhost:11434)

# ── 可选覆盖(默认取 config/llm_config.json)────────────────────────────
# THP_LLM_PROVIDER=deepseek
# THP_LLM_MODEL=deepseek-v4-pro
# THP_LLM_BASE_URL=https://api.deepseek.com
# THP_LLM_TIMEOUT=60
# THP_LLM_TEMPERATURE=0.5
# THP_LLM_MAX_TOKENS=4096     # 勿设超过 Provider 输出上限,否则所有调用 400
# THP_LLM_REASONING_EFFORT=   # 空=关闭; high / max(DeepSeek 思考模式)

# ── 服务器 ─────────────────────────────────────────────────────────────
# THP_SECRET_KEY=             # Flask 会话密钥;不设则每次启动随机生成

# ── 调试 ───────────────────────────────────────────────────────────────
# THP_LLM_LOG_TRAFFIC=1       # 终端打印 LLM 请求/响应流量
